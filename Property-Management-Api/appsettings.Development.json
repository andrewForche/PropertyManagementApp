{
  "ApiSettings": {
    "ApplicationName": "Property Management API",
    "EnvironmentName": "Local Development"
  },
  "Jwt": {
    "Issuer": "PropertyManagementApp",
    "Audience": "PropertyManagementApp.Client",
    "SigningKey": "PropertyManagementApp-Shared-Jwt-Secret-2026-Use-The-Same-Key-Everywhere",
    "AccessTokenExpirationMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Port=3306;Database=property_management_app;User Id=root;Password=NewStrongPassword123!;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "BasePath": "C:\\uploads\\property-docs"
  }
}